<!-- ===== v3.2 左侧悬浮速览条 + 检索 JS ===== -->
<script>
(function () {
    try {
        var CH = [
            ['1','系统定位'],['2','核心理念'],['3','系统架构'],['4','九件核心规格'],
            ['5','多平台产物扩展'],['6','其他扩展件'],['7','标准交付流程'],['8','质量门禁'],
            ['9','网站风格与结构规范'],['10','模板库与模板资产库'],['11','治理与演进'],
            ['12','参考案例'],['13','速查卡'],['14','通用避坑清单']
        ];
        var list = document.getElementById('railList');
        var q = document.getElementById('q');
        var cnt = document.getElementById('railCount');
        var pos = document.getElementById('railPos');
        if (!list || !q || !cnt || !pos) return;
        var cards = [];
        function findSec(t) {
            var all = document.querySelectorAll('.card');
            for (var i = 0; i < all.length; i++) {
                var h2 = all[i].querySelector('h2');
                if (h2 && h2.textContent.indexOf(t) !== -1) return all[i];
            }
            return null;
        }
        for (var i = 0; i < CH.length; i++) {
            cards.push({ n: CH[i][0], t: CH[i][1], el: findSec(CH[i][1]) });
        }
        var btns = [];
        function render() {
            list.innerHTML = '';
            btns = [];
            for (var i = 0; i < cards.length; i++) {
                (function (idx) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'rail-item';
                    b.textContent = cards[idx].n + ' ' + cards[idx].t;
                    b.onclick = function () {
                        var el = cards[idx].el;
                        if (!el) return;
                        var before = window.scrollY || document.documentElement.scrollTop || 0;
                        var y = el.getBoundingClientRect().top + before - 14;
                        try { window.scrollTo({ top: y, behavior: 'smooth' }); }
                        catch (e) { window.scrollTo(0, y); return; }
                        setTimeout(function () {
                            var after = window.scrollY || document.documentElement.scrollTop || 0;
                            if (Math.abs(after - before) < 2 && Math.abs(before - y) > 2) {
                                window.scrollTo(0, y);
                            }
                        }, 500);
                    };
                    list.appendChild(b);
                    btns.push(b);
                })(i);
            }
        }
        function clearMark(card) {
            var ms = card.querySelectorAll('mark');
            for (var i = 0; i < ms.length; i++) {
                var m = ms[i];
                var t = document.createTextNode(m.textContent);
                m.parentNode.replaceChild(t, m);
            }
        }
        function highlight(card, kw) {
            if (!kw) return;
            var walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT, {
                acceptNode: function (n) {
                    var p = n.parentNode;
                    if (p && (p.nodeName === 'SCRIPT' || p.nodeName === 'STYLE')) return NodeFilter.FILTER_REJECT;
                    return NodeFilter.FILTER_ACCEPT;
                }
            });
            var arr = [];
            while (walker.nextNode()) arr.push(walker.currentNode);
            var rx;
            try { rx = new RegExp(kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'); } catch (e) { return; }
            for (var i = 0; i < arr.length; i++) {
                var n = arr[i];
                var v = n.nodeValue;
                rx.lastIndex = 0;
                if (!rx.test(v)) continue;
                rx.lastIndex = 0;
                var frag = document.createDocumentFragment();
                var rest = v;
                var m;
                while ((m = rx.exec(rest)) !== null) {
                    if (m.index > 0) frag.appendChild(document.createTextNode(rest.slice(0, m.index)));
                    var mk = document.createElement('mark');
                    mk.textContent = m[0];
                    frag.appendChild(mk);
                    rest = rest.slice(m.index + m[0].length);
                    rx.lastIndex = 0;
                }
                if (rest) frag.appendChild(document.createTextNode(rest));
                n.parentNode.replaceChild(frag, n);
            }
        }
        function applyFilter() {
            var kw = (q.value || '').trim().toLowerCase();
            var shown = 0;
            var total = 0;
            for (var i = 0; i < cards.length; i++) {
                var c = cards[i];
                if (!c.el) { total++; continue; }
                total++;
                clearMark(c.el);
                var hit = !kw || (c.el.textContent || '').toLowerCase().indexOf(kw) !== -1;
                if (hit) { shown++; c.el.style.display = ''; if (kw) highlight(c.el, q.value.trim()); }
                else { c.el.style.display = 'none'; }
            }
            for (var j = 0; j < btns.length; j++) {
                var cj = cards[j];
                var ok = !kw || !cj.el || (cj.el.textContent || '').toLowerCase().indexOf(kw) !== -1;
                btns[j].style.display = ok ? '' : 'none';
            }
            cnt.textContent = kw ? ('命中 ' + shown + ' / ' + total + ' 章') : ('共 ' + total + ' 章');
        }
        var ticking = false;
        function updatePos() {
            var cur = 0;
            for (var i = 0; i < cards.length; i++) {
                var c = cards[i];
                if (!c.el) continue;
                var r = c.el.getBoundingClientRect();
                if (r.top <= 150) cur = i;
            }
            for (var j = 0; j < btns.length; j++) {
                btns[j].className = 'rail-item' + (j === cur ? ' on' : '');
            }
            pos.textContent = '当前位置：' + cards[cur].n + ' ' + cards[cur].t;
        }
        function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(function () { updatePos(); ticking = false; });
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        if (q) q.addEventListener('input', applyFilter);
        render();
        updatePos();
    } catch (e) { console.error(e); }
})();
</script>
<script>
/* v3.4 页面级 tab 切换：首页（主页） / 编译环境资产库（二级页） */
(function () {
    try {
        window.NADS2 = window.NADS2 || {};
        window.NADS2.page = function (k) {
            var home = document.getElementById('page-home');
            var asset = document.getElementById('page-asset');
            var th = document.getElementById('tab-home');
            var ta = document.getElementById('tab-asset');
            var rail = document.getElementById('rail');
            if (!home || !asset || !th || !ta) return;
            var isHome = k === 'home';
            home.style.display = isHome ? '' : 'none';
            asset.style.display = isHome ? 'none' : '';
            th.className = 'page-tab main ' + (isHome ? 'on' : 'off');
            ta.className = 'page-tab sub ' + (isHome ? 'off' : 'on');
            if (rail) rail.style.display = isHome ? '' : 'none';
            window.scrollTo(0, 0);
        };
    } catch (e) { console.error(e); }
})();
</script>
</body>
</html>
